<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
    <NotFound>
        <PageTitle>Not found · Wildbloom Wiki</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <h1>Not found</h1>
            <p role="alert">There's nothing at this address. Try the <a href="">overview</a> or press Ctrl K to search.</p>
        </LayoutView>
    </NotFound>
</Router>
